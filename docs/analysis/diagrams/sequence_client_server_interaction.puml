@startuml
title Client-Server Interaction - Redis-like Server

' Two pipelined requests in one write, as client libraries send them.
' With --io-threads above 1, the CommandHandler part runs on the keyspace
' thread and the replies come back to the session's strand.

actor Client
participant "Listener" as Listener
participant "Session\n(I/O thread)" as Session
participant "CommandHandler" as Handler
database "Keyspace" as DB
participant "AppendOnlyFile\n(--appendonly)" as Aof

Client -> Listener : connect
alt past --maxclients
  Listener --> Client : -ERR max number of clients reached, then close
else admitted
  Listener -> Session : start a session
end

Client -> Session : *3 SET k v  +  *2 GET k\n(one write, two requests)
Session -> Session : parse_pending(): two complete requests
Session -> Handler : execute the batch
Handler -> Handler : SET: known, arity 3 is fine
Handler -> DB : find_string("k"), store "v"
Handler -> Handler : GET: known, arity 2 is fine
Handler -> DB : find_string("k")
DB --> Handler : "v"
Handler -> Aof : after the batch: SET k v
Handler --> Session : +OK\\r\\n  $1\\r\\nv\\r\\n
Session -> Client : both replies, in one write

Client -> Session : *3 LPUSH k x
Session -> Handler : execute
Handler -> DB : find_or_create<List>("k")
DB --> Handler : WRONGTYPE (k holds a string)
Handler --> Session : -WRONGTYPE Operation against a key\nholding the wrong kind of value
Session -> Client : the error reply

Client -> Session : close the connection
Session -> Session : read finds end of file;\nthe session ends

@enduml
