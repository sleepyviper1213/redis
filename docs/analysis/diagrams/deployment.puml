@startuml
title Deployment - Redis-like Server

node "Client host" as ClientHost {
  artifact "redis-cli / redis-benchmark" as Cli
  artifact "Application\n(hiredis or any Redis client)" as App
  artifact "telnet\n(inline commands)" as Telnet
}

cloud "TCP/IP network" as Network

node "Server host\n(Linux or macOS)" as Server {
  artifact "redis_server\n(one process)" as Process
  folder "Working files" {
    file "dump.snap\n(--dump)" as Snap
    folder "appendonlydir/\n(--appenddir)" as AofDir {
      file "appendonly.manifest" as Manifest
      file "appendonly.<n>.base.snap" as Base
      file "appendonly.<n>.incr.aof" as Incr
    }
    file "redis_server.log\n(--log-file)" as Log
  }
  node "BGSAVE / rewrite child\n(fork)" as Child
}

Cli --> Network
App --> Network
Telnet --> Network
Network --> Process : RESP over TCP\n(--host, --port; default 6379)

Process --> Snap : SAVE, shutdown save;\nload at startup
Process --> Incr : logs every write\n(--appendfsync)
Process --> Manifest : load at startup
Process --> Log : log channels
Process --> Child : fork()
Child --> Snap : BGSAVE
Child --> Base : BGREWRITEAOF

note bottom of Server
  Linux and macOS only: CI builds and tests
  both. Windows is not supported.
end note

@enduml
