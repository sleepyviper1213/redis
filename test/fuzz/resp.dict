# RESP2 tokens for libFuzzer's -dict (DX-86): type prefixes, terminators,
# boundary lengths and common command names.
crlf="\x0d\x0a"
lf="\x0a"
array="*"
bulk="$"
simple="+"
error="-"
integer=":"
double=","
null="_"
minus_one="-1"
zero="0"
max_int="9223372036854775807"
min_int="-9223372036854775808"
overflow="9223372036854775808"
bulk_limit="536870912"
bulk_limit_plus_one="536870913"
array_reserve="1024"
inf="inf"
nan="nan"
exponent="1e308"
tab="\x09"
nul="\x00"
ping="PING"
get="GET"
set="SET"
echo="ECHO"
