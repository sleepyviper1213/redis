{
    "version": 6,
    "include": [
        "options.json",
        "toolchains.json",
        "testing.json"
    ],
    "configurePresets": [
        {
            "name": "x86_64-linux-gnu-clang",
            "displayName": "Linux Clang",
            "description": "One Ninja Multi-Config tree: Debug, Release, RelWithDebInfo, ThreadSanitizer, UndefinedSanitizer and RealtimeSanitizer. Only the sanitizer configurations are instrumented.",
            "inherits": [
                "dev-options",
                "x86_64-linux-gnu-clang-toolchain"
            ],
            "cacheVariables": {
                "REDIS_SANITIZER": "Thread;Undefined;Realtime"
            }
        },
        {
            "name": "x86_64-linux-gnu-clang-asan",
            "displayName": "Linux Clang / AddressSanitizer",
            "description": "A tree of its own: the dependencies are built with AddressSanitizer too (see asan-deps-*), which a shared tree cannot do for one configuration only. Build only the AddressSanitizer configuration here.",
            "inherits": [
                "asan-deps-clang",
                "dev-options",
                "x86_64-linux-gnu-clang-toolchain"
            ],
            "cacheVariables": {
                "REDIS_SANITIZER": "Address"
            }
        },
        {
            "name": "x86_64-linux-gnu-clang-fuzz",
            "displayName": "Linux Clang / libFuzzer",
            "description": "The fuzz harnesses of test/fuzz linked with libFuzzer, the code instrumented for it and for UBSan, in the AddressSanitizer configuration; dependencies as in the ASan tree. Build only the fuzzers here (DX-86, #51).",
            "inherits": [
                "asan-deps-clang",
                "dev-options",
                "x86_64-linux-gnu-clang-toolchain"
            ],
            "cacheVariables": {
                "REDIS_SANITIZER": "Address",
                "REDIS_BUILD_FUZZERS": "ON",
                "REDIS_ENABLE_IPO": "OFF"
            }
        },
        {
            "name": "x86_64-linux-gnu-clang-coverage",
            "displayName": "Linux Clang / coverage",
            "inherits": [
                "coverage-options",
                "x86_64-linux-gnu-clang-toolchain"
            ]
        },
        {
            "name": "x86_64-linux-gnu-clang-analysis",
            "displayName": "Linux Clang / analysis",
            "inherits": [
                "analysis-options",
                "x86_64-linux-gnu-clang-toolchain"
            ]
        }
    ],
    "buildPresets": [
        {
            "name": "x86_64-linux-gnu-clang-debug",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "Debug"
        },
        {
            "name": "x86_64-linux-gnu-clang-release",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "Release"
        },
        {
            "name": "x86_64-linux-gnu-clang-relwithdebinfo",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "RelWithDebInfo"
        },
        {
            "name": "x86_64-linux-gnu-clang-coverage",
            "configurePreset": "x86_64-linux-gnu-clang-coverage",
            "configuration": "Debug"
        },
        {
            "name": "x86_64-linux-gnu-clang-analysis",
            "configurePreset": "x86_64-linux-gnu-clang-analysis",
            "configuration": "Debug"
        },
        {
            "name": "x86_64-linux-gnu-clang-asan",
            "configurePreset": "x86_64-linux-gnu-clang-asan",
            "configuration": "AddressSanitizer"
        },
        {
            "name": "x86_64-linux-gnu-clang-fuzz",
            "configurePreset": "x86_64-linux-gnu-clang-fuzz",
            "configuration": "AddressSanitizer",
            "targets": [
                "redis_fuzz_resp_parser",
                "redis_fuzz_resp_request"
            ]
        },
        {
            "name": "x86_64-linux-gnu-clang-tsan",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "ThreadSanitizer"
        },
        {
            "name": "x86_64-linux-gnu-clang-ubsan",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "UndefinedSanitizer"
        },
        {
            "name": "x86_64-linux-gnu-clang-rtsan",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "RealtimeSanitizer"
        }
    ],
    "testPresets": [
        {
            "name": "x86_64-linux-gnu-clang-debug",
            "inherits": "test-base",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "Debug"
        },
        {
            "name": "x86_64-linux-gnu-clang-release",
            "inherits": "test-base",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "Release"
        },
        {
            "name": "x86_64-linux-gnu-clang-coverage",
            "inherits": "test-base",
            "configurePreset": "x86_64-linux-gnu-clang-coverage",
            "configuration": "Debug"
        },
        {
            "name": "x86_64-linux-gnu-clang-asan",
            "inherits": "asan-test-base",
            "configurePreset": "x86_64-linux-gnu-clang-asan",
            "configuration": "AddressSanitizer"
        },
        {
            "name": "x86_64-linux-gnu-clang-fuzz",
            "description": "Replays the corpus through the libFuzzer binaries; only the fuzzers are built in this tree.",
            "inherits": "asan-test-base",
            "configurePreset": "x86_64-linux-gnu-clang-fuzz",
            "configuration": "AddressSanitizer",
            "filter": {
                "include": {
                    "name": "^fuzz\\."
                }
            }
        },
        {
            "name": "x86_64-linux-gnu-clang-tsan",
            "inherits": "tsan-test-base",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "ThreadSanitizer"
        },
        {
            "name": "x86_64-linux-gnu-clang-ubsan",
            "inherits": "ubsan-test-base",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "UndefinedSanitizer"
        },
        {
            "name": "x86_64-linux-gnu-clang-rtsan",
            "inherits": "rtsan-test-base",
            "configurePreset": "x86_64-linux-gnu-clang",
            "configuration": "RealtimeSanitizer"
        }
    ],
    "workflowPresets": [
        {
            "name": "x86_64-linux-gnu-clang-debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "x86_64-linux-gnu-clang"
                },
                {
                    "type": "build",
                    "name": "x86_64-linux-gnu-clang-debug"
                },
                {
                    "type": "test",
                    "name": "x86_64-linux-gnu-clang-debug"
                }
            ]
        },
        {
