{
    "version": 6,
    "include": [
        "base.json"
    ],
    "configurePresets": [
        {
            "name": "x86_64-linux-gnu-gcc-toolchain",
            "hidden": true,
            "inherits": "vcpkg-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-gcc",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/x86_64-linux-gnu-gcc.cmake"
            }
        },
        {
            "name": "x86_64-linux-gnu-clang-toolchain",
            "hidden": true,
            "inherits": "vcpkg-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            },
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-clang",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/x86_64-linux-gnu-clang.cmake"
            }
        },
        {
            "name": "aarch64-apple-darwin-llvm-toolchain",
            "hidden": true,
            "inherits": "vcpkg-base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            },
            "cacheVariables": {
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "VCPKG_TARGET_TRIPLET": "arm64-osx-llvm",
                "VCPKG_HOST_TRIPLET": "arm64-osx-llvm",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/homebrew-llvm.cmake"
            }
        },
        {
            "name": "asan-deps-gcc",
            "hidden": true,
            "description": "Dependencies built with -fsanitize=address, so that Abseil's poisoning and generations agree between the library and our code.",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-gcc-asan"
            }
        },
        {
            "name": "asan-deps-clang",
            "hidden": true,
            "description": "Dependencies built with -fsanitize=address, so that Abseil's poisoning and generations agree between the library and our code.",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-clang-asan"
            }
        },
        {
            "name": "asan-deps-macos",
            "hidden": true,
            "description": "As asan-deps-gcc, for the Homebrew LLVM triplet.",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-osx-llvm-asan",
                "VCPKG_HOST_TRIPLET": "arm64-osx-llvm",
                "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/triplets"
            }
        }
    ]
}
