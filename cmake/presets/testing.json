{
    "version": 6,
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "scheduleRandom": true,
                "jobs": 0
            }
        },
        {
            "name": "asan-test-base",
            "hidden": true,
            "inherits": "test-base",
            "filter": {
                "exclude": {
                    "label": "^timing$"
                }
            },
            "environment": {
                "ASAN_OPTIONS": "abort_on_error=1:halt_on_error=1:strict_string_checks=1:detect_stack_use_after_return=1",
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "tsan-test-base",
            "hidden": true,
            "inherits": "test-base",
            "filter": {
                "exclude": {
                    "label": "^timing$"
                }
            },
            "environment": {
                "TSAN_OPTIONS": "halt_on_error=1:second_deadlock_stack=1:suppressions=${sourceDir}/test/tsan.supp"
            },
            "execution": {
                "noTestsAction": "error",
                "scheduleRandom": true,
                "jobs": 3
            }
        },
        {
            "name": "ubsan-test-base",
            "hidden": true,
            "inherits": "test-base",
            "filter": {
                "exclude": {
                    "label": "^timing$"
                }
            },
            "environment": {
                "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
            }
        },
        {
            "name": "rtsan-test-base",
            "hidden": true,
            "inherits": "test-base",
            "filter": {
                "exclude": {
                    "label": "^timing$"
                }
            },
            "environment": {
                "RTSAN_OPTIONS": "halt_on_error=true:print_stats_on_exit=true"
            }
        }
    ]
}
